{
  "_meta": {"natbench_profile": "1.0"},
  "name": "Mullvad VPN Test",
  "description": "DNS benchmark via Mullvad VPN — requires Mullvad CLI installed",
  "protocol": "udp",
  "count": 15,
  "timeout": 3.0,
  "workers": 15,
  "scorer": "default",
  "servers": "all",
  "include_system_dns": false,
  "vpn": {
    "enabled": true,
    "name": "Mullvad",
    "type": "mullvad",
    "verify_changed": true,
    "wait_seconds": 5,
    "restore_on_exit": true
  },
  "tags": ["vpn", "mullvad", "privacy"]
}

{
  "_meta": {"natbench_profile": "1.0"},
  "name": "VPN WireGuard Test",
  "description": "Benchmark DNS performance while connected via WireGuard VPN — edit connect/disconnect commands",
  "protocol": "udp",
  "count": 15,
  "timeout": 3.0,
  "workers": 15,
  "scorer": "default",
  "servers": "all",
  "include_system_dns": false,
  "vpn": {
    "enabled": true,
    "name": "WireGuard",
    "type": "wireguard",
    "connect_cmd": "wg-quick up wg0",
    "disconnect_cmd": "wg-quick down wg0",
    "verify_changed": true,
    "wait_seconds": 3,
    "restore_on_exit": true
  },
  "tags": ["vpn", "wireguard", "privacy"]
}
